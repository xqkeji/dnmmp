# 本地生成的 HTTPS 证书与私钥（切勿提交）
etc/nginx/ssl/

# 自动下载的 mkcert 二进制（bin/add-site.sh 是仓库自带的脚本，要入库；
# 写成 bin/* 而不是 bin/，否则 git 不会进入该目录，下面的例外无效）
bin/*
!bin/add-site.sh
!bin/upgrade.ps1

# 升级与重建前的本地备份（upgrade.sh / --backup-data 生成）
.upgrade-backup/
data.backup-*/

# 运行时数据库数据与日志（保留 .gitkeep 占位）
data/mysql/*
data/mongo/*
log/nginx/*
log/mysql/*
log/mongo/*
log/php/*
!data/mysql/.gitkeep
!data/mongo/.gitkeep
!log/nginx/.gitkeep
!log/mysql/.gitkeep
!log/mongo/.gitkeep
!log/php/.gitkeep

# 用户代码目录（保留 .gitkeep 占位）
code/*
!code/.gitkeep